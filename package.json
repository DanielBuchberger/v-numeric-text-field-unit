{
  "name": "@enrag/v-numeric-text-field-unit",
  "version": "4.0.0",
  "description": "Vue component for numeric text fields with unit conversion",
  "author": "Daniel Buchberger",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DanielBuchberger/v-numeric-text-field-unit.git"
  },
  "homepage": "https://github.com/DanielBuchberger/v-numeric-text-field-unit#readme",
  "bugs": {
    "url": "https://github.com/DanielBuchberger/v-numeric-text-field-unit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite"
  },
  "keywords": [
    "vue",
    "vuetify",
    "numeric",
    "unit-conversion",
    "text-field"
  ],
  "peerDependencies": {
    "lodash": "^4.18.1",
    "vue": "^3.5.34",
    "vuetify": "^4.0.0"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.24",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/language-core": "^3.3.1",
    "@vue/tsconfig": "^0.9.1",
    "lodash": "^4.18.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "vite-plugin-dts": "^5.0.1",
    "vue": "^3.5.34",
    "vuetify": "^4.0.7"
  }
}
